# Copier ce fichier en .env et compléter (voir README).

# Dashboard développeur Spotify > ton app > Settings
NUXT_OAUTH_SPOTIFY_CLIENT_ID=
NUXT_OAUTH_SPOTIFY_CLIENT_SECRET=
# Doit être identique à la Redirect URI déclarée dans le dashboard Spotify
NUXT_OAUTH_SPOTIFY_REDIRECT_URL=http://127.0.0.1:3000/auth/spotify

# Secret de chiffrement du cookie de session (32+ caractères) : openssl rand -base64 32
NUXT_APP_SECRET=
